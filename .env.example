# Copy this file to .env and fill in your own keys. Never commit .env.

# Google Maps Platform: enable "Places API (New)" in your Google Cloud project
GOOGLE_API_KEY=
# Google PageSpeed Insights (can be the same key if that API is allowed on it)
PAGESPEED_API_KEY=
# OpenAI: review summaries, blog analysis, cuisine detection fallback (optional; the app works without it)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Brave Search API: finds blogs, press and listings (optional)
BRAVE_API_KEY=

# Shown on the legal pages (optional)
CONTACT_EMAIL=

# Usage limits (defaults shown)
# LIMIT_SCANS_PER_IP_PER_DAY=8
# LIMIT_SCANS_PER_DAY=80

# Only needed when hosting under a path such as https://example.com/restaurantgrader/
# BASE_PATH=/restaurantgrader

# Set automatically on AWS (see DEPLOY.md). Leave empty locally.
# DATA_BUCKET=
# COUNTER_TABLE=
# ORIGIN_SECRET=
